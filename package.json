  "bugs": {
    "url": "https://github.com/axumquant/arch-viewer/issues"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "minimist": "^1.2.8",
    "open": "^10.1.0"
  },
  "engines": {
    "node": ">=18"
